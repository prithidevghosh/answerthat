# Copy to .env and fill in. The API will not start without the two required keys.
# This is deliberate: HR-2 / ADR-010. There is no anonymous mode.

# ---- REQUIRED. Startup aborts if either is absent or empty. ----
# free — request at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# free — register at https://openalex.org  (keys became mandatory 2026-02-13)
OPENALEX_API_KEY=

# Your contact email. OpenAlex sends polite-pool traffic to a real address; without it
# we get throttled, and throttling looks like an empty result rather than an error.
OPENALEX_MAILTO=

# Model access: planner, claim extraction, verifier, constrained repair tier.
# Not required at startup (HR-2 names exactly two keys); the features that need it
# raise rather than silently skipping their step.
ANTHROPIC_API_KEY=

# ---- Services. The defaults are the docker compose service names. ----
GROBID_URL=http://grobid:8070
DATABASE_URL=postgresql+asyncpg://answerthat:answerthat@postgres:5432/answerthat
REDIS_URL=redis://redis:6379/0
