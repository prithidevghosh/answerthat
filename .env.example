# Copy to .env and fill in. The API will not start without the three required keys.
# This is deliberate: HR-2 / ADR-010 / ADR-015. There is no anonymous mode.

# ---- REQUIRED. Startup aborts if any of these is absent or empty. ----
# free — request at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# free — register at https://openalex.org  (keys became mandatory 2026-02-13)
OPENALEX_API_KEY=
# https://platform.openai.com/api-keys
# Every LLM role goes through this one key: the constrained repair tier, claim
# extraction, candidate rerank, verification, the planner and text transforms
# (ADR-015), plus embeddings for anchor reattachment (ADR-016).
OPENAI_API_KEY=

# Your contact email. OpenAlex sends polite-pool traffic to a real address; without it
# we get throttled, and throttling looks like an empty result rather than an error.
OPENALEX_MAILTO=

# ---- LLM behaviour ----
# live   — call OpenAI
# record — call OpenAI and write every request/response pair to tests/recordings/llm
# replay — serve from those recordings; a cache miss RAISES rather than calling the
#          API. CI runs here, so a missing recording fails the build instead of
#          quietly hitting the network (ADR-018).
LLM_MODE=live

# ---- Services. The defaults are the docker compose service names. ----
GROBID_URL=http://grobid:8070
DATABASE_URL=postgresql+asyncpg://answerthat:answerthat@postgres:5432/answerthat
REDIS_URL=redis://redis:6379/0

# Uploaded PDFs land at {UPLOAD_DIR}/{doc_id}.pdf on a mounted volume (ADR-022).
UPLOAD_DIR=/data/uploads
